# Copy this file to .env and paste your key after the = sign.
# Free key (no credit card): https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=

# Which LLM backend to use: "groq" (live) or "mock" (offline, deterministic, no key needed)
SCHOLARPLAN_LLM=groq

# Contact email sent to OpenAlex/Crossref so they can reach you if something misbehaves
# ("polite pool" etiquette). Optional but recommended.
SCHOLARPLAN_CONTACT_EMAIL=
